<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 4.3-beta EXPERIMENT (Huawei hypothesis), remove if it changes nothing.
         Stock Android has no "navigation" permission for a home app, so these are the
         closest declarations that exist; none of them is used by Drift's code.
         REORDER_TASKS is a normal permission (granted at install); GET_TASKS is
         ignored by Android 5+ for third-party apps; the com.huawei.* ones are
         Huawei launcher permissions, unknown (and harmless) on other devices. -->
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <uses-permission android:name="android.permission.GET_TASKS" />
    <uses-permission android:name="com.huawei.android.launcher.permission.READ_SETTINGS" />
    <uses-permission android:name="com.huawei.android.launcher.permission.WRITE_SETTINGS" />

    <!-- Package visibility (Android 11+): without this only a handful of apps are visible.
         Declares exactly "apps that have a launcher entry"; no QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Read-only, for the diagnostics screen: which apps can be home, and which
             package serves the system gesture/recents service. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.QUICKSTEP_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/DriftTheme">

        <activity
            android:name=".LauncherActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|keyboard|navigation|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:stateNotNeeded="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Colours and background picture; opened from the "Drift settings" row of the app list. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="Drift settings" />

        <!-- Read-only report about system navigation on this firmware; opened from Drift's app list. -->
        <activity
            android:name=".DiagnosticsActivity"
            android:exported="true"
            android:label="Drift diagnostics">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Optional: lets Drift keep a still preview of each app on its card.
             Disabled until the user switches it on in Accessibility settings. -->
        <service
            android:name=".ThumbService"
            android:exported="true"
            android:label="@string/thumb_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/thumb_service" />
        </service>
    </application>
</manifest>
